# Server-side only (never prefix these with VITE_ — they must not reach the browser bundle).
OPENROUTER_API_KEY=
# Jev (decisions: crisis, which mind to recommend, triagem). Not a chat model.
JEV_MODEL=typesafe/jev-1.13
# Chat model that writes the Maestro's and the minds' replies.
OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-4.5
APP_URL=https://etternum.app

# Native app (Capacitor) builds only: absolute origin of the deployed web app that serves /api.
# VITE_API_BASE=https://etternum.app

# Supabase (opcional — os valores do projeto já estão em src/lib/supabase-config.js).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Protege /api/diagnostico (que gasta créditos): acesse /api/diagnostico?chave=<valor>.
# DIAGNOSTICO_CHAVE=
