# Banco de dados Postgres (local, Supabase, Neon...).
# Supabase: Project Settings → Database → Connection string (use a "Session pooler" na Vercel).
DATABASE_URL=postgres://etternum:etternum@localhost:5432/etternum

# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=

# Chave da API da Anthropic (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: modelo usado pelas cápsulas (padrão: claude-opus-5-5).
# ETTERNUM_MODEL=claude-opus-5-5

# Opcional: 1 = respostas simuladas, para desenvolver sem chave da API. Nunca use em produção.
# ETTERNUM_AI_MOCK=1

# Opcional: link do checkout do plano Premium (Stripe, Mercado Pago, Whop...).
# NEXT_PUBLIC_CHECKOUT_URL=
