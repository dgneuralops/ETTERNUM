# Banco de dados Postgres (local, Supabase, Neon...). Obrigatório em produção.
# Em desenvolvimento, sem DATABASE_URL o app usa um banco embutido (pasta .etternum-demo).
# Supabase: Project Settings → Database → Connection string (use a "Session pooler" na Vercel).
DATABASE_URL=postgres://etternum:etternum@localhost:5432/etternum

# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=

# IA das cápsulas — escolha UM provedor.
# OpenRouter (padrão quando a chave existe): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Anthropic (Claude) direto: https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Opcional: força o provedor ("openrouter" ou "anthropic") quando as duas chaves existem.
# ETTERNUM_AI_PROVIDER=openrouter

# Opcional: modelo usado pelas cápsulas.
# Padrão no OpenRouter: typesafe/jev-1.13 · padrão na Anthropic: claude-opus-5-5
# ETTERNUM_MODEL=typesafe/jev-1.13

# Opcional (OpenRouter): limite de tokens por resposta (padrão 4000) e URL pública do app (aparece no painel).
# OPENROUTER_MAX_TOKENS=4000
# NEXT_PUBLIC_APP_URL=https://etternum.app

# Opcional: 1 = respostas simuladas, para desenvolver sem chave da API. Nunca use em produção.
# ETTERNUM_AI_MOCK=1

# Opcional: link do checkout do plano Premium (Stripe, Mercado Pago, Whop...).
# NEXT_PUBLIC_CHECKOUT_URL=
